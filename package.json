{
  "name": "poc-prisma-vs-drizzle",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently \"pnpm run dev:prisma\" \"pnpm run dev:drizzle\"",
    "build": "pnpm run build:prisma && pnpm run build:drizzle",
    "dev:prisma": "pnpm --filter prisma-api run dev",
    "dev:drizzle": "pnpm --filter drizzle-api run dev",
    "build:prisma": "pnpm --filter prisma-api run build",
    "build:drizzle": "pnpm --filter drizzle-api run build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:migrate": "pnpm --filter prisma-api run prisma:migrate",
    "drizzle:migrate": "pnpm --filter drizzle-api run drizzle:migrate",
    "drizzle:generate": "pnpm --filter drizzle-api run drizzle:generate"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlejoMistra/PoC-Prisma-vs-Drizzle"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.4",
    "typescript": "^7.0.2"
  },
  "private": true
}
